        <mxCell id="legend" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;" value="+ público   - privado   # protegido&lt;br&gt;Línea sólida + triángulo hueco = generalización (herencia)&lt;br&gt;Línea sólida = asociación (con multiplicidad en cada extremo)&lt;br&gt;Línea punteada + flecha abierta = dependencia" vertex="1">
          <mxGeometry height="90" width="560" x="30" y="940" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
