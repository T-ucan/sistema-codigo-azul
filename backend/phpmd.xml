<?xml version="1.0"?>
<ruleset name="CodigoAzul"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Reglas de calidad del backend Codigo Azul. Umbrales alineados a los
        objetivos del proyecto: complejidad ciclomatica menor o igual a 5,
        acoplamiento entre objetos bajo, profundidad de herencia menor o
        igual a 2 (principio de sustitucion de Liskov), sin ifs/else
        anidados sobre estado, y sin codigo muerto.
    </description>

    <!-- Tamano/complejidad -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <!-- reportLevel = complejidad a partir de la cual se reporta violacion.
                 6 => cualquier metodo con complejidad >= 6 viola el limite <= 5. -->
            <property name="reportLevel" value="6" />
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity" />
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="40" />
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength" />
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="15" />
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <!-- Entidades ricas (Usuario, Evento) exponen un getter por
                 atributo, que es diseno normal, no una responsabilidad de mas. -->
            <property name="maxmethods" value="12" />
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <!-- Las entidades Llamado/CodigoAzul modelan 1:1 las columnas de
                 su tabla (ver database/); construirlas con argumentos con
                 nombre es mas claro que un builder para este tamano. El
                 nombre real de esta propiedad en PHPMD es "minimum" (umbral
                 de reporte), no "maximum". -->
            <property name="minimum" value="11" />
        </properties>
    </rule>

    <!-- Diseno: acoplamiento y herencia -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <!-- CBO bajo: mas estricto que el default de la herramienta (13),
                 pero sin penalizar un controlador delgado que referencia sus
                 propios casos de uso, la entidad que devuelve y los tipos
                 comunes de la capa HTTP (Request/JsonResponse/Rol). -->
            <property name="maximum" value="12" />
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/DepthOfInheritance">
        <properties>
            <!-- Sustitucion de Liskov: se permite hasta 2 niveles de
                 herencia, se reporta a partir de 3. El nombre real de esta
                 propiedad en PHPMD es "minimum" (umbral de reporte), no
                 "maximum". -->
            <property name="minimum" value="3" />
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/EvalExpression" />
    <rule ref="rulesets/design.xml/ExitExpression" />
    <rule ref="rulesets/design.xml/GotoStatement" />

    <!-- Codigo limpio: nada de if/else anidados sobre estado -->
    <rule ref="rulesets/cleancode.xml/ElseExpression" />
    <rule ref="rulesets/cleancode.xml/IfStatementAssignment" />
    <rule ref="rulesets/cleancode.xml/BooleanArgumentFlag" />
    <!--
        StaticAccess (cleancode) queda deliberadamente FUERA del set: penaliza
        por igual una llamada a una funcion pura y sin estado (RuleValidator::
        evaluar(), Texto::normalizar(), TiempoTranscurrido::enMinutos()) que a
        una fabrica con nombre idiomatica en PHP (Usuario::crear(),
        JsonResponse::exito()). Ninguna de las dos esconde una dependencia que
        debiera inyectarse: no hay estado global ni nada que mockear. Forzar
        inyeccion de dependencias ahi solo agregaria ceremonia sin bajar el
        acoplamiento real (ya cubierto por CouplingBetweenObjects arriba).
    -->

    <!-- Codigo muerto / basura -->
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateField" />
    <rule ref="rulesets/unusedcode.xml/UnusedLocalVariable" />
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateMethod" />
    <rule ref="rulesets/unusedcode.xml/UnusedFormalParameter" />
</ruleset>
